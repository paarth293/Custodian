# Build output
target/
dist/
build/
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
playwright-report/
test-results/
*.profraw
*.profdata
*.tsbuildinfo
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/runtime-stage/*
!apps/desktop/src-tauri/runtime-stage/.gitkeep
# Extra outputs of `tauri icon`; this desktop app does not bundle them.
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/
apps/desktop/src-tauri/icons/64x64.png

# Dependencies
node_modules/
.venv/
venv/
.npm/
.cache/
.eslintcache

# Local archives, rendered deliverables and ad-hoc run artifacts
/.local/
/artifacts/
/deliverables/
/video/exports/
/video/**/*.mp4
/video/**/*.mov
/video/**/*.webm
/video/**/*.mkv
/video/**/*.wav
/video/**/*.mp3

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Models and local data (fetched separately, never committed)
models/*
!models/.gitkeep
*.gguf
/data/
fixture/*
!fixture/.gitkeep

# Local app/runtime state and generated evidence
.freebuff/
docs/EVIDENCE/local/
*.sqlite
*.sqlite3
*.db
*.pid
*.pid.lock

# Environment and local secrets
.env
.env.*
!.env.example

# Logs and OS/editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*.local.json
