# Build output
target/
dist/
build/
coverage/
*.tsbuildinfo
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/runtime-stage/*
!apps/desktop/src-tauri/runtime-stage/.gitkeep
# Extra outputs of `tauri icon`; this desktop app does not bundle them.
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/
apps/desktop/src-tauri/icons/64x64.png

# Dependencies
node_modules/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Models and local data (fetched separately, never committed)
models/*
!models/.gitkeep
*.gguf
data/
fixture/*
!fixture/.gitkeep

# Local app/runtime state and generated evidence
.freebuff/
docs/EVIDENCE/local/
*.sqlite
*.sqlite3
*.db

# Environment and local secrets
.env
.env.*
!.env.example

# Logs and OS/editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*.local.json
