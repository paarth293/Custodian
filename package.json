{
  "name": "custodian",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/desktop",
    "services/agent",
    "services/broker",
    "services/orchestrator",
    "services/editor-adapter"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "repo:check": "node scripts/check-repository.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run clean && tsc -b && npm run build -w apps/desktop",
    "typecheck": "tsc -b && npm run typecheck -w apps/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "fixtures": "cargo run -p custodian-fixtures --release --",
    "proto:gen": "node scripts/gen-proto.mjs"
  },
  "overrides": {
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "quicktype-core": "^26.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.3"
  }
}
