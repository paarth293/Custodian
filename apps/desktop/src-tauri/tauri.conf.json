{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custodian",
  "version": "0.1.0",
  "identifier": "com.custodian.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node ../../scripts/stage-runtime.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installerHooks": "windows/offline-prerequisite.nsh" }
    },
    "resources": { "runtime-stage/": "runtime/" },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
